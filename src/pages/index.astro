---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<BaseLayout title="Iqra Society Blog - Home" lang="en">
  <div class="hero">
    <h1 class="hero-title">Welcome to Iqra Society</h1>
    <p class="hero-description">
      Promoting Islamic knowledge and education through accessible content
    </p>
  </div>

  <section class="latest-posts">
    <h2>Latest Articles</h2>
    <div class="posts-grid">
      {posts.map((post) => (
        <article class="post-card">
          <a href={`/blog/${post.slug}`} class="post-link">
            {post.data.image && (
              <div class="post-card-image">
                <img src={post.data.image} alt={post.data.title} />
              </div>
            )}
            <div class="post-card-content">
              <h3>{post.data.title}</h3>
              <p class="post-excerpt">{post.data.description}</p>
              <div class="post-card-meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {new Intl.DateTimeFormat('en', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  }).format(post.data.pubDate)}
                </time>
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="features">
    <h2>What We Offer</h2>
    <div class="features-grid">
      <div class="feature-card">
        <h3>📚 Islamic Education</h3>
        <p>In-depth articles on Quranic studies, Hadith, and Islamic history</p>
      </div>
      <div class="feature-card">
        <h3>🌍 Multilingual Content</h3>
        <p>Available in English, Arabic, and Indonesian</p>
      </div>
      <div class="feature-card">
        <h3>💡 Contemporary Topics</h3>
        <p>Islamic perspectives on modern issues and challenges</p>
      </div>
      <div class="feature-card">
        <h3>🤝 Community Focus</h3>
        <p>Stories and insights from our diverse community</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 4rem 2rem;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
    border-radius: 1rem;
    margin-bottom: 3rem;
    color: var(--color-background);
  }

  .hero-title {
    font-size: 3rem;
    margin-bottom: 1rem;
    color: var(--color-background);
  }

  .hero-description {
    font-size: 1.5rem;
    opacity: 0.95;
  }

  .latest-posts {
    margin-bottom: 4rem;
  }

  .latest-posts h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  .post-card {
    background-color: var(--color-background);
    border: 2px solid var(--color-secondary);
    border-radius: 0.75rem;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .post-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .post-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .post-card-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .post-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .post-card:hover .post-card-image img {
    transform: scale(1.05);
  }

  .post-card-content {
    padding: 1.5rem;
  }

  .post-card-content h3 {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--color-primary);
  }

  .post-excerpt {
    color: var(--color-text);
    opacity: 0.8;
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .post-card-meta {
    font-size: 0.875rem;
    color: var(--color-text);
    opacity: 0.6;
  }

  .features {
    margin-bottom: 4rem;
  }

  .features h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
    text-align: center;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .feature-card {
    background-color: var(--color-secondary);
    padding: 2rem;
    border-radius: 0.75rem;
    text-align: center;
    transition: transform 0.3s ease;
  }

  .feature-card:hover {
    transform: translateY(-5px);
  }

  .feature-card h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--color-primary);
  }

  .feature-card p {
    color: var(--color-text);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2rem;
    }

    .hero-description {
      font-size: 1.125rem;
    }

    .posts-grid {
      grid-template-columns: 1fr;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
